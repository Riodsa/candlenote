# Copy to backend/.env and fill in the keys.
DATABASE_URL=postgresql+asyncpg://investing:investing@localhost:5433/investing
FINNHUB_API_KEY=your_finnhub_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
CORS_ORIGINS=http://localhost:3000
# Seconds between REST polls for symbols without a streaming feed (e.g. XAUUSD)
POLL_INTERVAL_SECONDS=5
