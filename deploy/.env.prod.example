# Copy to .env.prod on the VPS (never commit .env.prod)
POSTGRES_PASSWORD=replace_with_strong_random_password
FINNHUB_API_KEY=your_finnhub_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
# 30s keeps Twelve Data free tier (800 credits/day) safer if a tab stays open
POLL_INTERVAL_SECONDS=30
# Localhost-only port on the VPS for `tailscale serve --bg 8080`
APP_PORT=8080
